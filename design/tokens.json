{
  "$description": "Afterglow design tokens — dark, dense, warm running tracker",
  "color": {
    "bg":          { "$value": "#0e0b09", "$type": "color", "$description": "near-black warmed page background" },
    "surface":     { "$value": "#17120f", "$type": "color", "$description": "tile and panel surface" },
    "surface-2":   { "$value": "#201915", "$type": "color", "$description": "raised surface: inputs, zebra rows, tooltips" },
    "line":        { "$value": "#2e2520", "$type": "color", "$description": "hairline borders, dividers, chart grid" },
    "ink":         { "$value": "#f8f2eb", "$type": "color", "$description": "primary text" },
    "ink-2":       { "$value": "#c0ae9f", "$type": "color", "$description": "secondary text, subs, captions" },
    "ink-3":       { "$value": "#8a7a6e", "$type": "color", "$description": "faint text: labels, section heads, footer" },
    "accent":      { "$value": "#ff8c3a", "$type": "color", "$description": "sunset orange, hero accent" },
    "accent-deep": { "$value": "#e8590c", "$type": "color", "$description": "button gradient start" },
    "accent-hi":   { "$value": "#ff922b", "$type": "color", "$description": "button gradient end" },
    "accent-dim":  { "$value": "#4d2c17", "$type": "color", "$description": "dim orange border on accent surfaces" },
    "mark":        { "$value": "#a3552a", "$type": "color", "$description": "dimmed orange for past-week bars" },
    "lime":        { "$value": "#c9f24f", "$type": "color", "$description": "good-news accent, up-ticks, safe state" },
    "warn":        { "$value": "#ff6a5c", "$type": "color", "$description": "danger countdown, delete hover, errors" },
    "on-accent":   { "$value": "#ffffff", "$type": "color", "$description": "text on the orange button" }
  },
  "font": {
    "sans": { "$value": "\"Nunito\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "$type": "fontFamily" },
    "num":  { "$value": "\"Nunito\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "$type": "fontFamily", "$description": "no separate mono face; tabular-nums supplies the mono accent" }
  },
  "text": {
    "hero":  { "$value": "56px", "$type": "dimension", "$description": "streak count" },
    "stat":  { "$value": "30px", "$type": "dimension", "$description": "stat tile value" },
    "clock": { "$value": "28px", "$type": "dimension", "$description": "live countdown clock" },
    "title": { "$value": "24px", "$type": "dimension", "$description": "page h1" },
    "lg":    { "$value": "15px", "$type": "dimension", "$description": "unit beside hero number" },
    "base":  { "$value": "14px", "$type": "dimension", "$description": "body default" },
    "sm":    { "$value": "13px", "$type": "dimension", "$description": "list rows, buttons" },
    "xs":    { "$value": "12px", "$type": "dimension", "$description": "captions, footer" },
    "label": { "$value": "11px", "$type": "dimension", "$description": "uppercase micro-labels" }
  },
  "space": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "6px",  "$type": "dimension" },
    "3":  { "$value": "8px",  "$type": "dimension" },
    "4":  { "$value": "10px", "$type": "dimension" },
    "5":  { "$value": "12px", "$type": "dimension" },
    "6":  { "$value": "14px", "$type": "dimension" },
    "7":  { "$value": "16px", "$type": "dimension" },
    "8":  { "$value": "18px", "$type": "dimension" },
    "9":  { "$value": "20px", "$type": "dimension" },
    "10": { "$value": "24px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "l":    { "$value": "18px",  "$type": "dimension", "$description": "tiles, hero, panels" },
    "m":    { "$value": "12px",  "$type": "dimension", "$description": "buttons, inputs" },
    "s":    { "$value": "10px",  "$type": "dimension", "$description": "tooltip" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "delete chip" }
  },
  "shadow": {
    "hero":       { "$value": "0 14px 36px -18px rgba(255, 140, 58, .45)", "$type": "shadow" },
    "button":     { "$value": "0 8px 20px -10px rgba(232, 89, 12, .7)", "$type": "shadow" },
    "pop":        { "$value": "0 10px 30px rgba(0, 0, 0, .6)", "$type": "shadow" },
    "focus":      { "$value": "0 0 0 3px rgba(255, 140, 58, .18)", "$type": "shadow" },
    "glow-text":  { "$value": "0 0 28px rgba(255, 140, 58, .35)", "$type": "shadow", "$description": "text-shadow on the hero number" }
  }
}
